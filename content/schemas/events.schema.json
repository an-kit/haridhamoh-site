{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "date", "startTime", "endTime", "location", "image", "description"],
    "properties": {
      "title": { "type": "string", "minLength": 1 },
      "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "startTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
      "endTime": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
      "endTimeNote": {
        "type": "string",
        "minLength": 1,
        "description": "Non-public editorial metadata; it must not render or appear in JSON-LD.",
        "$comment": "non-public"
      },
      "location": { "type": "string", "minLength": 1 },
      "image": { "type": "string", "pattern": "^/uploads/" },
      "zeffyUrl": { "type": "string", "format": "uri" },
      "description": { "type": "string", "minLength": 1 },
      "recap": { "type": "string", "minLength": 1 },
      "media": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "src", "thumb", "alt"],
              "properties": {
                "type": { "const": "photo" },
                "src": { "type": "string", "pattern": "^/uploads/" },
                "thumb": { "type": "string", "pattern": "^/uploads/" },
                "alt": { "type": "string", "minLength": 1 },
                "caption": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "videoId", "title"],
              "properties": {
                "type": { "const": "youtube" },
                "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
                "title": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    }
  }
}
